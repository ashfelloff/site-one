---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { BLOG } from "@consts";
import { Image } from "astro:assets";
import exifr from 'exifr';
import fs from 'node:fs';
import path from 'node:path';

interface Photo {
  image: ImageMetadata;
  date: Date;
  location: string;
  coords: string;
  tech: {
    device: string;
    lens: string;
    iso: string;
    f: string;
    shutter: string;
    reso: string;
  };
  id: string;
}

// Simplification: Locations now use raw GPS coordinates strictly
async function getFriendlyLocation(lat: number, lon: number): Promise<string> {
  return `${lat.toFixed(2)}, ${lon.toFixed(2)}`;
}

const imageFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/gallery/*.{jpeg,jpg,png,webp,JPEG,JPG,PNG,WEBP}", { eager: true });

const photos: Photo[] = await Promise.all(
  Object.entries(imageFiles).map(async ([filepath, module]) => {
    const image = module.default;
    const absolutePath = path.resolve(process.cwd(), filepath.startsWith('/') ? filepath.slice(1) : filepath);
    
    let metadata: any;
    try {
      const buffer = fs.readFileSync(absolutePath);
      metadata = await exifr.parse(buffer);
    } catch (e) {}

    const date = metadata?.DateTimeOriginal || fs.statSync(absolutePath).birthtime || new Date();
    const device = metadata?.Model ? `${metadata.Make || ''} ${metadata.Model}`.trim() : "";
    const iso = metadata?.ISO ? `ISO ${metadata.ISO}` : "";
    const aperture = metadata?.FNumber ? `f/${Number(metadata.FNumber).toFixed(1)}` : "";
    const exposure = metadata?.ExposureTime ? (metadata.ExposureTime < 1 ? `1/${Math.round(1/metadata.ExposureTime)}` : `${metadata.ExposureTime}s`) : "";
    
    const location = metadata?.latitude ? await getFriendlyLocation(metadata.latitude, metadata.longitude) : path.basename(filepath, path.extname(filepath)).replace(/[-_]/g, " ");

    return {
      image,
      date,
      location,
      coords: metadata?.latitude ? `${metadata.latitude.toFixed(2)}, ${metadata.longitude.toFixed(2)}` : "",
      tech: {
        device,
        lens: metadata?.LensModel?.replace("BACK CAMERA", "BC") || "Native",
        iso,
        f: aperture,
        shutter: exposure,
        reso: `${image.width} × ${image.height}`
      },
      id: path.basename(filepath)
    };
  })
);

photos.sort((a, b) => b.date.valueOf() - a.date.valueOf());

const formatDate = (date: Date) => {
  return Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(date);
};
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        a blog kinda
      </div>
      
      {photos.length === 0 ? (
        <div class="animate opacity-50 italic">
          more to come soon..
        </div>
      ) : (
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 animate relative z-0">
          {photos.map((photo, index) => (
            <div 
              class="photo-item relative aspect-square overflow-hidden rounded-xl cursor-pointer group bg-neutral-900 border border-white/5"
              data-index={index}
              data-photo={JSON.stringify({
                src: photo.image.src,
                location: photo.location,
                coords: photo.coords,
                date: formatDate(photo.date),
                tech: photo.tech
              })}
            >
              <Image 
                src={photo.image} 
                alt={photo.location} 
                class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" 
                loading="lazy"
                decoding="async"
                widths={[240, 400, 600]}
                sizes="(max-width: 768px) 50vw, 33vw"
                quality="mid"
              />
            </div>
          ))}
        </div>
      )}
    </div>
  </Container>

  <!-- Solid Immersive Lightbox Overlay -->
  <div id="lightbox" class="fixed inset-0 z-[400] bg-black opacity-0 pointer-events-none transition-opacity duration-200 flex flex-col items-center overflow-y-auto">
    
    <!-- Top Bar: Close (Fixed) -->
    <div class="sticky top-0 w-full h-20 px-6 flex items-center justify-end z-[220]">
      <button id="close-lightbox" class="text-white/40 hover:text-white transition-colors p-2 bg-black/40 backdrop-blur-md rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Image Area -->
    <div class="relative w-full flex flex-col items-center justify-center px-4 -mt-10 md:mt-0">
      <div class="relative max-w-6xl w-full flex justify-center">
        <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[45vh] md:max-h-[70vh] object-contain shadow-2xl transition-opacity duration-150" />
      </div>

      <!-- Integrated Switcher (Below Image) - Now Desktop & Mobile -->
      <div class="mt-8 flex items-center gap-8 px-5 py-2 bg-white/5 border border-white/10 rounded-full z-[250]">
        <button id="mobile-prev" class="text-white/20 active:text-white transition-colors p-2 cursor-pointer hover:text-white/60">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <span class="text-white/40 text-[9px] font-mono tracking-[0.3em] min-w-[40px] text-center">
          <span id="lb-index">0</span> / <span id="lb-total">0</span>
        </span>
        <button id="mobile-next" class="text-white/20 active:text-white transition-colors p-2 cursor-pointer hover:text-white/60">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
    
    <!-- Info Section: Cleaned duplicate GPS -->
    <div class="w-full max-w-5xl px-8 pb-32 pt-12 md:pt-16 bg-black">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-x-12 gap-y-12">
        
        <!-- Details Column -->
        <div class="space-y-4 max-w-xl pr-4">
           <h2 id="lb-location" class="text-white text-2xl md:text-3xl font-medium tracking-tight"></h2>
           <div class="flex items-center gap-4 text-white/30 text-[10px] md:text-xs font-mono uppercase tracking-[0.3em]">
             <span id="lb-date"></span>
           </div>
        </div>

        <!-- Tech/Shot Column -->
        <div class="w-full md:w-auto overflow-x-auto no-scrollbar border-t border-white/5 pt-10 md:pt-0 md:border-t-0 -mx-8 px-8 md:mx-0 md:px-0">
          <div class="flex items-end gap-x-12 min-w-max pb-4 md:pb-0">
            <div class="flex flex-col gap-3">
               <span class="text-white/20 text-[9px] uppercase tracking-[0.4em] font-bold">Gear</span>
               <div class="space-y-1">
                  <p id="lb-device" class="text-white/80 text-[11px] uppercase tracking-wide"></p>
                  <p id="lb-lens" class="text-white/30 text-[9px] uppercase tracking-wider max-w-[140px] truncate"></p>
               </div>
            </div>
            
            <div class="flex flex-col gap-3 border-l border-white/5 pl-8 md:pl-10">
               <span class="text-white/20 text-[9px] uppercase tracking-[0.4em] font-bold">Shot</span>
               <div class="flex items-center gap-6 text-white/80 text-[11px] font-mono leading-none">
                  <div class="flex flex-col gap-1">
                    <span id="lb-shutter"></span>
                    <span class="text-[8px] text-white/20 uppercase tracking-widest opacity-50">Exp</span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span id="lb-f"></span>
                    <span class="text-[8px] text-white/20 uppercase tracking-widest opacity-50">Ap</span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span id="lb-iso"></span>
                    <span class="text-[8px] text-white/20 uppercase tracking-widest opacity-50">Iso</span>
                  </div>
               </div>
            </div>

            <div class="flex flex-col gap-3 border-l border-white/5 pl-8 md:pl-10 pr-8 md:pr-0">
               <span class="text-white/20 text-[9px] uppercase tracking-[0.4em] font-bold">Reso</span>
               <span id="lb-reso" class="text-white/40 text-[11px] font-mono whitespace-nowrap"></span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</PageLayout>

<script>
  function initLightbox() {
    const items = document.querySelectorAll('.photo-item');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    
    // Meta hooks
    const lbLocation = document.getElementById('lb-location');
    const lbDate = document.getElementById('lb-date');
    const lbDevice = document.getElementById('lb-device');
    const lbLens = document.getElementById('lb-lens');
    const lbShutter = document.getElementById('lb-shutter');
    const lbF = document.getElementById('lb-f');
    const lbIso = document.getElementById('lb-iso');
    const lbReso = document.getElementById('lb-reso');
    const lbIndex = document.getElementById('lb-index');
    const lbTotal = document.getElementById('lb-total');
    
    // Buttons
    const closeBtn = document.getElementById('close-lightbox');
    const mPrev = document.getElementById('mobile-prev');
    const mNext = document.getElementById('mobile-next');
    
    if (!lightbox || !lightboxImg || !items.length) return;

    let currentIndex = 0;
    if (lbTotal) lbTotal.textContent = items.length.toString();

    function preloadImage(url: string) {
      if (!url) return;
      const img = new window.Image();
      img.src = url;
    }

    // Lazy Parsing: Extract data only when needed to prevent main-thread block
    function getPhotoData(item: Element) {
      return JSON.parse(item.getAttribute('data-photo') || '{}');
    }

    function updateLightbox(index: number, skipFade = false) {
      if (index < 0 || index >= items.length) return;
      currentIndex = index;
      const data = getPhotoData(items[index]);
      
      if (skipFade) {
        lightboxImg.src = data.src;
      } else {
        lightboxImg.style.opacity = "0";
        lightboxImg.src = data.src;
        lightboxImg.onload = () => lightboxImg.style.opacity = "1";
      }

      // Defer preloading slightly to prioritize the current image view
      setTimeout(() => {
        if (index + 1 < items.length) preloadImage(getPhotoData(items[index + 1]).src);
        if (index - 1 >= 0) preloadImage(getPhotoData(items[index - 1]).src);
      }, 300);

      if (lbLocation) lbLocation.textContent = data.location || "";
      if (lbDate) lbDate.textContent = data.date || "—";
      if (lbDevice) lbDevice.textContent = data.tech.device || "—";
      if (lbLens) lbLens.textContent = data.tech.lens || "—";
      if (lbShutter) lbShutter.textContent = data.tech.shutter || "—";
      if (lbF) lbF.textContent = data.tech.f || "—";
      if (lbIso) lbIso.textContent = data.tech.iso || "—";
      if (lbReso) lbReso.textContent = data.tech.reso || "—";
      if (lbIndex) lbIndex.textContent = (index + 1).toString();
    }

    // Attach listeners immediately to ensure clickability
    items.forEach((item, index) => {
      item.addEventListener('click', () => {
        updateLightbox(index);
        lightbox?.classList.remove('pointer-events-none');
        lightbox?.classList.add('opacity-100');
        document.body.style.overflow = 'hidden';
      });
    });

    closeBtn?.addEventListener('click', () => {
      lightbox?.classList.add('pointer-events-none');
      lightbox?.classList.remove('opacity-100');
      document.body.style.overflow = '';
    });
    
    function next() { if (currentIndex < items.length - 1) updateLightbox(currentIndex + 1, true); }
    function prev() { if (currentIndex > 0) updateLightbox(currentIndex - 1, true); }

    mPrev?.addEventListener('click', prev);
    mNext?.addEventListener('click', next);

    // Swipe Support
    let touchstartX = 0;
    let touchendX = 0;

    lightbox.addEventListener('touchstart', e => {
      touchstartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lightbox.addEventListener('touchend', e => {
      touchendX = e.changedTouches[0].screenX;
      handleGesture();
    }, { passive: true });

    function handleGesture() {
      const diff = touchendX - touchstartX;
      if (Math.abs(diff) < 50) return; // Prevent accidental swipes
      if (diff < 0) next();
      if (diff > 0) prev();
    }

    document.addEventListener('keydown', (e) => {
      if (lightbox?.classList.contains('opacity-100')) {
        if (e.key === 'Escape') closeBtn?.click();
        if (e.key === 'ArrowLeft') prev();
        if (e.key === 'ArrowRight') next();
      }
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeBtn?.click();
    });
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  #lightbox-img { opacity: 1; transition: opacity 0.15s ease-in-out; }
</style>
