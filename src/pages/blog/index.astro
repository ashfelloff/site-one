---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { BLOG } from "@consts";
import { Image } from "astro:assets";
import exifr from 'exifr';
import fs from 'node:fs';
import path from 'node:path';

interface Photo {
  image: ImageMetadata;
  date: Date;
  location: string;
  coords: string;
  tech: {
    device: string;
    lens: string;
    iso: string;
    f: string;
    shutter: string;
    reso: string;
  };
  id: string;
}

const locationCache = new Map<string, string>();

async function getFriendlyLocation(lat: number, lon: number): Promise<string> {
  const roundedLat = lat.toFixed(3);
  const roundedLon = lon.toFixed(3);
  const key = `${roundedLat},${roundedLon}`;
  
  if (locationCache.has(key)) return locationCache.get(key) || key;
  
  try {
    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json&accept-language=en`, {
      headers: { 'User-Agent': 'PersonalSite/1.0 (contact: ashwxth@gmail.com)' }
    });
    const data = await response.json();
    const addr = data.address;
    
    const specific = addr.amenity || addr.landmark || addr.building || addr.road || addr.pedestrian || addr.suburb || addr.neighbourhood || "";
    const city = addr.city || addr.town || addr.village || "";
    const country = addr.country || "";
    
    let result = "";
    if (specific) {
       result = city ? `${specific}, ${city}` : specific;
    } else if (city) {
       result = addr.state ? `${city}, ${addr.state}` : city;
    } else {
       result = country || key;
    }

    locationCache.set(key, result);
    return result;
  } catch (e) {
    return key;
  }
}

const imageFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/gallery/*.{jpeg,jpg,png,webp,JPEG,JPG,PNG,WEBP}", { eager: true });

const photos: Photo[] = await Promise.all(
  Object.entries(imageFiles).map(async ([filepath, module]) => {
    const image = module.default;
    const absolutePath = path.resolve(process.cwd(), filepath.startsWith('/') ? filepath.slice(1) : filepath);
    
    let metadata: any;
    try {
      const buffer = fs.readFileSync(absolutePath);
      metadata = await exifr.parse(buffer);
    } catch (e) {}

    const date = metadata?.DateTimeOriginal || fs.statSync(absolutePath).birthtime || new Date();
    const device = metadata?.Model ? `${metadata.Make || ''} ${metadata.Model}`.trim() : "";
    const iso = metadata?.ISO ? `ISO ${metadata.ISO}` : "";
    const aperture = metadata?.FNumber ? `f/${Number(metadata.FNumber).toFixed(2)}` : "";
    const exposure = metadata?.ExposureTime ? (metadata.ExposureTime < 1 ? `1/${Math.round(1/metadata.ExposureTime)}` : `${metadata.ExposureTime}s`) : "";
    
    const location = metadata?.latitude ? await getFriendlyLocation(metadata.latitude, metadata.longitude) : path.basename(filepath, path.extname(filepath)).replace(/[-_]/g, " ");

    return {
      image,
      date,
      location,
      coords: metadata?.latitude ? `${metadata.latitude.toFixed(2)}, ${metadata.longitude.toFixed(2)}` : "",
      tech: {
        device,
        lens: metadata?.LensModel?.replace("BACK CAMERA", "BC") || "Native",
        iso,
        f: aperture,
        shutter: exposure,
        reso: `${image.width} × ${image.height}`
      },
      id: path.basename(filepath)
    };
  })
);

photos.sort((a, b) => b.date.valueOf() - a.date.valueOf());

const formatDate = (date: Date) => {
  return Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(date);
};
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Gallery
      </div>
      
      {photos.length === 0 ? (
        <div class="animate opacity-50 italic">
          more to come soon..
        </div>
      ) : (
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 animate relative z-0">
          {photos.map((photo, index) => (
            <div 
              class="photo-item relative aspect-square overflow-hidden rounded-xl cursor-pointer group bg-neutral-900 shadow-lg"
              data-index={index}
              data-photo={JSON.stringify({
                src: photo.image.src,
                location: photo.location,
                coords: photo.coords,
                date: formatDate(photo.date),
                tech: photo.tech
              })}
            >
              <Image src={photo.image} alt={photo.location} class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110" />
            </div>
          ))}
        </div>
      )}
    </div>
  </Container>

  <!-- Solid Immersive Lightbox Overlay -->
  <div id="lightbox" class="fixed inset-0 z-[200] bg-black opacity-0 pointer-events-none transition-opacity duration-300 flex flex-col items-center">
    
    <!-- Top Bar: Close -->
    <div class="w-full h-20 px-6 flex items-center justify-end">
      <button id="close-lightbox" class="text-white/40 hover:text-white transition-colors p-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Main Content Area: Centered Image -->
    <div class="relative flex-1 w-full flex items-center justify-center p-4">
      <div class="relative max-w-6xl max-h-full">
        <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[50vh] md:max-h-[70vh] object-contain transition-opacity duration-300 shadow-2xl" />
        
        <!-- Desktop Nav Arrows -->
        <button id="prev-photo" class="hidden md:block absolute left-[-100px] top-1/2 -translate-y-1/2 text-white/10 hover:text-white/60 transition-all p-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button id="next-photo" class="hidden md:block absolute right-[-100px] top-1/2 -translate-y-1/2 text-white/10 hover:text-white/60 transition-all p-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
    
    <!-- Info Section: Scrollable/Fixed Bottom Area -->
    <div class="w-full max-w-5xl px-8 pb-12 pt-8 md:pt-12 bg-black">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-x-12 gap-y-12">
        
        <!-- Details Column -->
        <div class="space-y-4 max-w-xl">
           <h2 id="lb-location" class="text-white text-2xl md:text-4xl font-medium tracking-tight leading-tight"></h2>
           <div class="flex items-center gap-4 text-white/30 text-[10px] md:text-xs font-mono uppercase tracking-[0.3em]">
             <span id="lb-coords"></span>
             <span class="opacity-20">/</span>
             <span id="lb-date"></span>
           </div>
        </div>

        <!-- Tech/Shot Column -->
        <div class="grid grid-cols-2 md:flex md:items-end gap-x-12 gap-y-10 w-full md:w-auto px-1 border-t border-white/5 pt-10 md:pt-0 md:border-t-0">
          <div class="flex flex-col gap-3">
             <span class="text-white/20 text-[9px] uppercase tracking-[0.4em] font-bold">Gear</span>
             <div class="space-y-1.5">
                <p id="lb-device" class="text-white/80 text-[11px] uppercase tracking-wide"></p>
                <p id="lb-lens" class="text-white/30 text-[9px] uppercase tracking-wider truncate max-w-[140px]"></p>
             </div>
          </div>
          
          <div class="flex flex-col gap-3 border-l border-white/5 pl-8 md:pl-10">
             <span class="text-white/20 text-[9px] uppercase tracking-[0.4em] font-bold">Shot</span>
             <div class="flex items-center gap-5 text-white/80 text-[11px] font-mono leading-none">
                <span id="lb-shutter"></span>
                <span id="lb-f"></span>
                <span id="lb-iso"></span>
             </div>
          </div>

          <div class="flex flex-col gap-3 border-l border-white/5 pl-8 md:pl-10">
             <span class="text-white/20 text-[9px] uppercase tracking-[0.4em] font-bold">Reso</span>
             <span id="lb-reso" class="text-white/40 text-[11px] font-mono whitespace-nowrap"></span>
          </div>
        </div>

      </div>
    </div>

    <!-- Floating Navigation Bar (Mobile Switcher) -->
    <div class="fixed bottom-10 left-1/2 -translate-x-1/2 md:hidden z-[210]">
      <div class="flex items-center gap-8 px-6 py-3 bg-white/5 backdrop-blur-xl border border-white/10 rounded-full shadow-2xl">
        <button id="mobile-prev" class="text-white/40 active:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <span class="text-white/60 text-[10px] font-mono tracking-widest min-w-[50px] text-center">
          <span id="lb-index">0</span> <span class="opacity-30">/</span> <span id="lb-total">0</span>
        </span>
        <button id="mobile-next" class="text-white/40 active:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  function initLightbox() {
    const items = document.querySelectorAll('.photo-item');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    
    // Meta data hooks
    const lbLocation = document.getElementById('lb-location');
    const lbCoords = document.getElementById('lb-coords');
    const lbDate = document.getElementById('lb-date');
    const lbDevice = document.getElementById('lb-device');
    const lbLens = document.getElementById('lb-lens');
    const lbShutter = document.getElementById('lb-shutter');
    const lbF = document.getElementById('lb-f');
    const lbIso = document.getElementById('lb-iso');
    const lbReso = document.getElementById('lb-reso');
    const lbIndex = document.getElementById('lb-index');
    const lbTotal = document.getElementById('lb-total');
    
    // Buttons
    const closeBtn = document.getElementById('close-lightbox');
    const prevBtn = document.getElementById('prev-photo');
    const nextBtn = document.getElementById('next-photo');
    const mPrev = document.getElementById('mobile-prev');
    const mNext = document.getElementById('mobile-next');
    
    if (!lightbox || !lightboxImg || !items.length) return;

    let currentIndex = 0;
    const photoData = Array.from(items).map(item => JSON.parse(item.getAttribute('data-photo') || '{}'));
    if (lbTotal) lbTotal.textContent = photoData.length.toString();

    function updateLightbox(index: number) {
      if (index < 0 || index >= photoData.length) return;
      currentIndex = index;
      const data = photoData[index];
      
      lightboxImg.style.opacity = "0";
      setTimeout(() => {
        lightboxImg.src = data.src;
        lightboxImg.style.opacity = "1";
      }, 150);

      if (lbLocation) lbLocation.textContent = data.location || "";
      if (lbCoords) lbCoords.textContent = data.coords || "—";
      if (lbDate) lbDate.textContent = data.date || "—";
      if (lbDevice) lbDevice.textContent = data.tech.device || "—";
      if (lbLens) lbLens.textContent = data.tech.lens || "—";
      if (lbShutter) lbShutter.textContent = data.tech.shutter || "—";
      if (lbF) lbF.textContent = data.tech.f || "—";
      if (lbIso) lbIso.textContent = data.tech.iso || "—";
      if (lbReso) lbReso.textContent = data.tech.reso || "—";
      if (lbIndex) lbIndex.textContent = (index + 1).toString();
    }

    function openLightbox(index: number) {
      updateLightbox(index);
      lightbox?.classList.remove('pointer-events-none');
      lightbox?.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox?.classList.add('pointer-events-none');
      lightbox?.classList.remove('opacity-100');
      document.body.style.overflow = '';
    }

    items.forEach((item, index) => {
      item.addEventListener('click', () => openLightbox(index));
    });

    closeBtn?.addEventListener('click', closeLightbox);
    
    const handleNext = () => currentIndex < photoData.length - 1 && updateLightbox(currentIndex + 1);
    const handlePrev = () => currentIndex > 0 && updateLightbox(currentIndex - 1);

    prevBtn?.addEventListener('click', handlePrev);
    nextBtn?.addEventListener('click', handleNext);
    mPrev?.addEventListener('click', handlePrev);
    mNext?.addEventListener('click', handleNext);

    document.addEventListener('keydown', (e) => {
      if (lightbox?.classList.contains('opacity-100')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') handlePrev();
        if (e.key === 'ArrowRight') handleNext();
      }
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>
