---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { BLOG } from "@consts";
import { Image } from "astro:assets";
import exifr from 'exifr';
import fs from 'node:fs';
import path from 'node:path';

interface Photo {
  image: ImageMetadata;
  date: Date;
  location: string;
  coords: string;
  tech: {
    device: string;
    lens: string;
    iso: string;
    f: string;
    shutter: string;
    reso: string;
  };
  id: string;
}

// Simple cache for geocoding to avoid rate limits
const locationCache = new Map<string, string>();

async function getFriendlyLocation(lat: number, lon: number): Promise<string> {
  const roundedLat = lat.toFixed(2);
  const roundedLon = lon.toFixed(2);
  const key = `${roundedLat},${roundedLon}`;
  
  if (locationCache.has(key)) return locationCache.get(key) || key;
  
  try {
    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json&accept-language=en`, {
      headers: { 'User-Agent': 'PersonalSite/1.0 (contact: ashwxth@gmail.com)' }
    });
    const data = await response.json();
    const city = data.address.city || data.address.town || data.address.village || data.address.suburb || "";
    const country = data.address.country || "";
    const result = city ? `${city}, ${country}` : country || key;
    locationCache.set(key, result);
    return result;
  } catch (e) {
    return key;
  }
}

// Get all images from src/assets/gallery/
const imageFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/gallery/*.{jpeg,jpg,png,webp,JPEG,JPG,PNG,WEBP}", { eager: true });

const photos: Photo[] = await Promise.all(
  Object.entries(imageFiles).map(async ([filepath, module]) => {
    const image = module.default;
    const absolutePath = path.resolve(process.cwd(), filepath.startsWith('/') ? filepath.slice(1) : filepath);
    
    let metadata: any;
    try {
      const buffer = fs.readFileSync(absolutePath);
      metadata = await exifr.parse(buffer);
    } catch (e) {}

    const date = metadata?.DateTimeOriginal || fs.statSync(absolutePath).birthtime || new Date();
    
    const device = metadata?.Model ? `${metadata.Make || ''} ${metadata.Model}`.trim() : "";
    const lensRaw = metadata?.LensModel || "";
    // Clean up long lens names
    const lens = lensRaw.length > 30 ? lensRaw.split(' ').slice(0, 5).join(' ') + "..." : lensRaw;
    
    const iso = metadata?.ISO ? `ISO ${metadata.ISO}` : "";
    const aperture = metadata?.FNumber ? `f/${Number(metadata.FNumber).toFixed(2)}` : "";
    const exposure = metadata?.ExposureTime ? (metadata.ExposureTime < 1 ? `1/${Math.round(1/metadata.ExposureTime)}` : `${metadata.ExposureTime}s`) : "";
    const resolution = `${image.width} × ${image.height}`;

    let location = "";
    let coords = "";
    if (metadata?.latitude && metadata?.longitude) {
      coords = `${metadata.latitude.toFixed(2)}, ${metadata.longitude.toFixed(2)}`;
      location = await getFriendlyLocation(metadata.latitude, metadata.longitude);
    } else {
      const basename = path.basename(filepath, path.extname(filepath));
      location = basename
        .split(/[-_]/)
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
    }

    return {
      image,
      date,
      location,
      coords,
      tech: {
        device,
        lens: lens || "Native",
        iso,
        f: aperture,
        shutter: exposure,
        reso: resolution
      },
      id: path.basename(filepath)
    };
  })
);

photos.sort((a, b) => b.date.valueOf() - a.date.valueOf());

const formatDate = (date: Date) => {
  return Intl.DateTimeFormat("en-US", {
    month: "short",
    year: "numeric"
  }).format(date);
};
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Gallery
      </div>
      
      {photos.length === 0 ? (
        <div class="animate opacity-50 italic">
          more to come soon..
        </div>
      ) : (
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 animate">
          {photos.map((photo, index) => (
            <div 
              class="photo-item relative aspect-square overflow-hidden rounded-xl cursor-pointer group bg-neutral-900 shadow-lg"
              data-index={index}
              data-photo={JSON.stringify({
                src: photo.image.src,
                location: photo.location,
                coords: photo.coords,
                date: formatDate(photo.date),
                tech: photo.tech
              })}
            >
              <Image 
                src={photo.image} 
                alt={photo.location}
                class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                <p class="text-white text-xs font-medium truncate">
                  {photo.location}
                </p>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </Container>

  <!-- Lightbox Overlay -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-black/98 opacity-0 pointer-events-none transition-opacity duration-300 flex flex-col items-center justify-center p-4">
    <!-- Close -->
    <button id="close-lightbox" class="absolute top-6 right-6 text-white/50 hover:text-white z-[110] transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    
    <!-- Controls -->
    <button id="prev-photo" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/20 hover:text-white z-[110] p-4 transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    
    <button id="next-photo" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/20 hover:text-white z-[110] p-4 transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    <!-- Main Content -->
    <div class="relative max-w-6xl w-full h-[70vh] flex items-center justify-center">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain shadow-2xl rounded-sm" />
    </div>
    
    <!-- Redesigned Technical Info Bar -->
    <div class="mt-12 w-full max-w-5xl px-6 pb-8">
      <div class="flex flex-col md:flex-row justify-between items-center md:items-end gap-x-12 gap-y-10">
        
        <!-- Left: Branding & Location -->
        <div class="flex items-end gap-x-8 border-l border-white/10 pl-8">
          <div class="text-center md:text-left space-y-1">
             <p id="lb-location" class="text-white text-xl md:text-2xl font-medium tracking-tight mb-1"></p>
             <div class="flex items-center gap-3 text-white/30 text-xs font-mono">
                <span id="lb-coords"></span>
                <span class="opacity-20">|</span>
                <span id="lb-date"></span>
             </div>
          </div>
        </div>
        
        <!-- Right: Technical Details Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:flex lg:items-end gap-x-8 gap-y-6 text-[10px] uppercase tracking-[0.25em] text-white/30 font-semibold w-full md:w-auto">
          
          <div class="flex flex-col gap-1.5 min-w-[120px]">
             <span class="text-white/50 text-[9px] tracking-widest opacity-80">Device</span>
             <span id="lb-device" class="text-white/80 leading-tight"></span>
          </div>

          <div class="flex flex-col gap-1.5 min-w-[140px] max-w-[200px]">
             <span class="text-white/50 text-[9px] tracking-widest opacity-80">Optics</span>
             <span id="lb-lens" class="text-white/80 leading-tight truncate"></span>
          </div>

          <div class="flex items-end gap-8 border-l border-white/5 pl-8">
            <div class="flex flex-col gap-1.5">
               <span class="text-white/50 text-[9px] tracking-widest opacity-80">Exp</span>
               <span id="lb-shutter" class="text-white/80"></span>
            </div>
            <div class="flex flex-col gap-1.5">
               <span class="text-white/50 text-[9px] tracking-widest opacity-80">Ap</span>
               <span id="lb-f" class="text-white/80"></span>
            </div>
            <div class="flex flex-col gap-1.5">
               <span class="text-white/50 text-[9px] tracking-widest opacity-80">ISO</span>
               <span id="lb-iso" class="text-white/80"></span>
            </div>
          </div>

          <div class="flex flex-col gap-1.5 border-l border-white/5 pl-8 ml-auto sm:ml-0">
             <span class="text-white/50 text-[9px] tracking-widest opacity-80">Output</span>
             <span id="lb-reso" class="text-white/80"></span>
          </div>

        </div>

      </div>
    </div>
  </div>
</PageLayout>

<script>
  function initLightbox() {
    const items = document.querySelectorAll('.photo-item');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    
    const lbLocation = document.getElementById('lb-location');
    const lbCoords = document.getElementById('lb-coords');
    const lbDate = document.getElementById('lb-date');
    const lbDevice = document.getElementById('lb-device');
    const lbLens = document.getElementById('lb-lens');
    const lbShutter = document.getElementById('lb-shutter');
    const lbF = document.getElementById('lb-f');
    const lbIso = document.getElementById('lb-iso');
    const lbReso = document.getElementById('lb-reso');
    
    const closeBtn = document.getElementById('close-lightbox');
    const prevBtn = document.getElementById('prev-photo');
    const nextBtn = document.getElementById('next-photo');
    
    if (!lightbox || !lightboxImg || !items.length) return;

    let currentIndex = 0;
    const photoData = Array.from(items).map(item => JSON.parse(item.getAttribute('data-photo') || '{}'));

    function updateLightbox(index: number) {
      if (index < 0 || index >= photoData.length) return;
      currentIndex = index;
      const data = photoData[index];
      
      lightboxImg.style.opacity = "0";
      setTimeout(() => {
        lightboxImg.src = data.src;
        lightboxImg.style.opacity = "1";
      }, 150);

      if (lbLocation) lbLocation.textContent = data.location || "";
      if (lbCoords) lbCoords.textContent = data.coords || "";
      if (lbDate) lbDate.textContent = data.date || "";
      if (lbDevice) lbDevice.textContent = data.tech.device || "—";
      if (lbLens) lbLens.textContent = data.tech.lens || "—";
      if (lbShutter) lbShutter.textContent = data.tech.shutter || "—";
      if (lbF) lbF.textContent = data.tech.f || "—";
      if (lbIso) lbIso.textContent = data.tech.iso || "—";
      if (lbReso) lbReso.textContent = data.tech.reso || "—";
      
      if (prevBtn) prevBtn.style.visibility = index === 0 ? "hidden" : "visible";
      if (nextBtn) nextBtn.style.visibility = index === photoData.length - 1 ? "hidden" : "visible";
    }

    function openLightbox(index: number) {
      updateLightbox(index);
      lightbox?.classList.remove('pointer-events-none');
      lightbox?.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox?.classList.add('pointer-events-none');
      lightbox?.classList.remove('opacity-100');
      document.body.style.overflow = '';
    }

    items.forEach((item, index) => {
      item.addEventListener('click', () => openLightbox(index));
    });

    closeBtn?.addEventListener('click', closeLightbox);
    
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentIndex > 0) updateLightbox(currentIndex - 1);
    });
    
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentIndex < photoData.length - 1) updateLightbox(currentIndex + 1);
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox?.classList.contains('opacity-100')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft' && currentIndex > 0) updateLightbox(currentIndex - 1);
        if (e.key === 'ArrowRight' && currentIndex < photoData.length - 1) updateLightbox(currentIndex + 1);
      }
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
  #lightbox-img {
    transition: opacity 0.3s ease-in-out;
  }
</style>
