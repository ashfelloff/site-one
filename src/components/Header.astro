---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<header id="site-header" class="fixed top-0 left-0 w-full z-[300] transition-all duration-500 ease-in-out py-6">
  <Container>
    <div id="header-inner" class="flex flex-wrap gap-y-2 justify-between items-center transition-all duration-500 ease-in-out max-w-full overflow-hidden">
      <div id="wordmark-wrapper" class="transition-all duration-500 ease-in-out origin-left flex-shrink-0">
        <Link href="/" underline={false}>
          <div id="wordmark-container" class="group flex items-center font-medium whitespace-nowrap" style="font-family: 'Druk Wide', sans-serif;">
            <span class="inline-block translate-y-[0.05em]">✱</span>a<span id="wordmark">c</span>
            <span class="animate-pulse ml-0.5 opacity-50 group-hover:opacity-0 transition-opacity duration-300">|</span>
          </div>
        </Link>
      </div>
      
      <nav id="nav-menu" class="flex gap-1 transition-all duration-500 ease-in-out md:translate-x-0">
        <Link href="/blog">
          blog
        </Link>
        <span>
          {`/`}
        </span>
        <Link href="/work">
          work
        </Link>
        <span>
          {`/`}
        </span>
        <Link href="/projects">
          projects
        </Link>
      </nav>
    </div>
  </Container>
</header>

<style>
  #site-header {
    background-color: transparent;
    backdrop-filter: blur(0px);
    border-bottom: 1px solid transparent;
  }

  /* Desktop Telescope Header */
  @media (min-width: 768px) {
    #site-header.scrolled {
      padding-top: 1rem;
      padding-bottom: 1rem;
      background-color: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    #site-header.scrolled #wordmark-wrapper {
      opacity: 0;
      max-width: 0;
      transform: translateX(-15px);
      pointer-events: none;
    }

    #site-header.scrolled #header-inner {
      justify-content: center;
    }

    #site-header.scrolled #nav-menu {
      transform: translateX(-65px);
    }
  }

  /* Mobile Omnibar (Hide on Scroll Down, Show on Up) */
  @media (max-width: 767px) {
    #site-header.nav-hidden {
      transform: translateY(-100%);
      opacity: 0;
    }
    
    #site-header.nav-visible {
      background-color: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(20px);
      padding-top: 1.2rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
  }
</style>

<script>
  function initHeaderScroll() {
    const header = document.getElementById("site-header");
    let lastScrollTop = 0;
    
    if (header) {
      window.addEventListener("scroll", () => {
        let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        
        // Desktop Scrolled state
        if (window.innerWidth >= 768) {
          if (scrollTop > 40) {
            header.classList.add("scrolled");
          } else {
            header.classList.remove("scrolled");
          }
        } else {
          // Mobile Omnibar Logic
          if (scrollTop > lastScrollTop && scrollTop > 100) {
            // Scrolling Down - Hide
            header.classList.add("nav-hidden");
            header.classList.remove("nav-visible");
          } else if (scrollTop < lastScrollTop) {
            // Scrolling Up - Show
            header.classList.remove("nav-hidden");
            if (scrollTop > 40) {
              header.classList.add("nav-visible");
            } else {
              header.classList.remove("nav-visible");
            }
          }
          lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }
      });
    }
  }
  
  document.addEventListener("astro:page-load", initHeaderScroll);

  function initHeaderWordmark() {
    const words = ["c", "shfelloff", "shvoided"];
    let wordIndex = 0;
    let charIndex = words[wordIndex].length;
    let isDeleting = true;
    let isPaused = false;
    const element = document.getElementById("wordmark");
    const container = document.getElementById("wordmark-container");

    if (container) {
      container.addEventListener("mouseenter", () => isPaused = true);
      container.addEventListener("mouseleave", () => isPaused = false);
    }

    function type() {
      if (isPaused) {
        setTimeout(type, 100);
        return;
      }

      const currentWord = words[wordIndex];
      const nextWord = words[(wordIndex + 1) % words.length];
      
      let commonPrefix = "";
      for (let i = 0; i < Math.min(currentWord.length, nextWord.length); i++) {
        if (currentWord[i] === nextWord[i]) {
          commonPrefix += currentWord[i];
        } else {
          break;
        }
      }

      if (isDeleting) {
        charIndex--;
      } else {
        charIndex++;
      }

      if (element) {
        element.textContent = currentWord.substring(0, charIndex);
      }

      let typeSpeed = isDeleting ? 75 : 150;

      if (!isDeleting && charIndex === currentWord.length) {
        isDeleting = true;
        typeSpeed = 5000; 
      } else if (isDeleting && charIndex === commonPrefix.length) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        typeSpeed = 500; 
      }

      setTimeout(type, typeSpeed);
    }

    setTimeout(type, 3000);
  }

  document.addEventListener("astro:page-load", initHeaderWordmark);
</script>
